# Where the FastAPI backend runs (used by the /api rewrite in next.config.ts, server side)
BACKEND_URL=http://localhost:8000

# Must equal API_KEY in fastapi-app/.env. Added to every /api request by src/middleware.ts;
# browsers never see it. Leave unset only if the backend has no API_KEY.
# BACKEND_API_KEY=

# Backend address as seen from the BROWSER, used for live video <img> links (they bypass the proxy).
# Change it when users open the portal from another PC. Baked in at build time: restart/rebuild after changing.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
